#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Snapshots hold cron command lines, network details and package lists: keep
    # them private to root. install -d also tightens directories from older versions,
    # which hides any older, umask-default snapshot files inside them. pending/ keeps
    # reports that failed to upload, configs/ copies of configs fetched from a URL:
    # pydebuprep itself never creates a directory.
    install -d -m 0700 /var/lib/pydebuprep /var/lib/pydebuprep/snapshots /var/lib/pydebuprep/pending /var/lib/pydebuprep/configs
    # pydebuprep-cleanup's log, and the config files it backs up before purging.
    install -d -m 0750 /var/log/pydebuprep
    install -d -m 0700 /var/backups/pydebuprep
fi

#DEBHELPER#

exit 0
