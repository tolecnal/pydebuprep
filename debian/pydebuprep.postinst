#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Snapshots hold cron command lines, network details and package lists: keep
    # them private to root. install -d also tightens directories from older versions,
    # which hides any older, umask-default snapshot files inside them.
    install -d -m 0700 /var/lib/pydebuprep /var/lib/pydebuprep/snapshots
fi

#DEBHELPER#

exit 0
