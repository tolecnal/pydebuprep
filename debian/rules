#!/usr/bin/make -f

export PYBUILD_NAME=pydebuprep
export PYBUILD_SYSTEM=distutils
# Run the suite from the source tree, where pyproject.toml configures pytest.
export PYBUILD_TEST_CUSTOM=1
export PYBUILD_TEST_ARGS=cd {dir} && {interpreter} -m pytest -q -p no:cacheprovider

%:
	dh $@ --with python3 --buildsystem=pybuild

# pydebuprep-cleanup is an administrator's command (man section 8): /usr/sbin.
execute_after_dh_auto_install:
	mkdir -p debian/pydebuprep/usr/sbin
	mv debian/pydebuprep/usr/bin/pydebuprep-cleanup debian/pydebuprep/usr/sbin/
