#compdef pydebuprep
# zsh completion for pydebuprep -- generated by `pydebuprep completion zsh`; do not edit by hand
#
# Installed packages put this in a directory on $fpath. Elsewhere, after compinit:
#   source <(pydebuprep completion zsh)

_pydebuprep_checks() {
    _values -s , 'check' apparmor apt-autoremove apt-held apt-lists-age apt-sources apt-upgradable bind boot-space boot-time bootloader config-conflicts cron debsums disk-space dkms dmesg-errors docker dpkg-audit dpkg-rc firewall fstab journal-errors kernel-running mariadb needrestart network obsolete-packages os-release postfix postgresql python-venvs ssh-server systemd-critical-services systemd-failed systemd-timers time-sync unattended-upgrades
}

_pydebuprep_check_options() {
    if [[ $PREFIX == *=* ]]; then
        local -a values
        case ${PREFIX%%=*} in
        disk-space.include_remote) values=(true false) ;;
        systemd-critical-services.builtin) values=(true false) ;;
        esac
        compset -P '*='
        compadd -a values
        return
    fi
    local -a opts
    opts=(apt-lists-age.max_age_days= boot-space.critical_pct= boot-space.warning_pct= config-conflicts.critical_paths= config-conflicts.ignore_paths= debsums.timeout_seconds= disk-space.critical_pct= disk-space.exclude_mounts= disk-space.important_mounts= disk-space.include_remote= disk-space.min_free_mib= disk-space.warning_pct= dmesg-errors.ignore= journal-errors.ignore= network.ignore_interfaces= python-venvs.exclude_paths= python-venvs.max_depth= python-venvs.search_paths= systemd-critical-services.builtin= systemd-critical-services.ignore_units= systemd-critical-services.required_active= systemd-critical-services.required_enabled= systemd-failed.ignore_units= systemd-timers.ignore_units=)
    compadd -S '' -a opts
}

# Options valid when they come first, i.e. for the implicit report command; only
# here are the top-level flags (--version, --help) allowed.
_pydebuprep_first() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '(--format -f)--format=[output format]:format:(text json yaml html markdown jira confluence)' \
        '(--format -f)-f[output format]:format:(text json yaml html markdown jira confluence)' \
        '(--output --output-dir -o)--output-dir=[write the report to a timestamped file in DIR instead of stdout]:output-dir:_files -/' \
        '(--output --output-dir -o)--output=[write the report to FILE (a timestamp is added if FILE exists); '\''-'\'' means standard output, overriding a configured output_dir]:output:_files' \
        '(--output --output-dir -o)-o[write the report to FILE (a timestamp is added if FILE exists); '\''-'\'' means standard output, overriding a configured output_dir]:output:_files' \
        '(--baseline --no-baseline)--baseline=[compare against this snapshot]:baseline:_files' \
        '(--baseline --no-baseline)--no-baseline[do not compare against any snapshot]' \
        '--snapshot-dir=[where to look for the newest snapshot]:snapshot-dir:_files -/' \
        '--checks=[run only these checks]:checks:_pydebuprep_checks' \
        '--skip=[do not run these checks]:skip:_pydebuprep_checks' \
        '--min-severity=[hide findings below this severity]:min-severity:(info warning critical)' \
        '--no-color[never colorize text output]' \
        '*--check-option=[set a check option, overriding the config file (repeatable)]:check-option:_pydebuprep_check_options' \
        '(--config --no-config -c)--config=[read settings from FILE]:config:_files' \
        '(--config --no-config -c)-c[read settings from FILE]:config:_files' \
        '(--config --no-config -c)--no-config[ignore any config file]' \
        '--version[show program'\''s version number and exit]'
}

