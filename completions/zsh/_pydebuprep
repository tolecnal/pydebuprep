#compdef pydebuprep
# zsh completion for pydebuprep -- generated by `pydebuprep completion zsh`; do not edit by hand

_pydebuprep_checks() {
    _values -s , 'check' apt-autoremove apt-held apt-lists-age apt-sources apt-upgradable boot-space boot-time bootloader config-conflicts debsums disk-space dkms dmesg-errors dpkg-audit dpkg-rc fstab journal-errors kernel-running needrestart obsolete-packages os-release systemd-failed systemd-timers
}

_pydebuprep_check_options() {
    local -a opts
    opts=(apt-lists-age.max_age_days= boot-space.critical_pct= boot-space.warning_pct= config-conflicts.critical_paths= debsums.timeout_seconds= disk-space.critical_pct= disk-space.exclude_mounts= disk-space.include_remote= disk-space.warning_pct= dmesg-errors.ignore= journal-errors.ignore= systemd-failed.ignore_units= systemd-timers.ignore_units=)
    compadd -S '' -a opts
}

_pydebuprep_report() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '(--format -f)--format[output format]:format:(text json yaml html markdown jira confluence)' \
        '(--format -f)-f[output format]:format:(text json yaml html markdown jira confluence)' \
        '--output-dir[write the report to a timestamped file in DIR instead of stdout]:output-dir:_files -/' \
        '(--output -o)--output[write the report to FILE (a timestamp is added if FILE exists); '\''-'\'' means standard output, overriding a configured output_dir]:output:_files' \
        '(--output -o)-o[write the report to FILE (a timestamp is added if FILE exists); '\''-'\'' means standard output, overriding a configured output_dir]:output:_files' \
        '--baseline[compare against this snapshot]:baseline:_files' \
        '--no-baseline[do not compare against any snapshot]' \
        '--snapshot-dir[where to look for the newest snapshot]:snapshot-dir:_files -/' \
        '--checks[run only these checks]:checks:_pydebuprep_checks' \
        '--skip[do not run these checks]:skip:_pydebuprep_checks' \
        '--min-severity[hide findings below this severity]:min-severity:(info warning critical)' \
        '--no-color[never colorize text output]' \
        '*--check-option[set a check option, overriding the config file (repeatable)]:check-option:_pydebuprep_check_options' \
        '(--config -c)--config[read settings from FILE]:config:_files' \
        '(--config -c)-c[read settings from FILE]:config:_files' \
        '--no-config[ignore any config file]' \
        '--version[show program'\''s version number and exit]'
}

_pydebuprep_snapshot() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '--snapshot-dir[where to store the snapshot]:snapshot-dir:_files -/' \
        '*--check-option[set a check option, overriding the config file (repeatable)]:check-option:_pydebuprep_check_options' \
        '(--config -c)--config[read settings from FILE]:config:_files' \
        '(--config -c)-c[read settings from FILE]:config:_files' \
        '--no-config[ignore any config file]'
}

_pydebuprep_list_checks() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '(--verbose -v)--verbose[also show each check'\''s options]' \
        '(--verbose -v)-v[also show each check'\''s options]'
}

_pydebuprep_configtest() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '(--config -c)--config[read settings from FILE]:config:_files' \
        '(--config -c)-c[read settings from FILE]:config:_files' \
        '--no-config[ignore any config file]'
}

_pydebuprep_example_config() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]'
}

_pydebuprep_completion() {
    _arguments -s -S \
        '(--help -h)--help[show this help message and exit]' \
        '(--help -h)-h[show this help message and exit]' \
        '1:completion:(bash zsh)'
}

_pydebuprep() {
    local -a commands
    commands=(
        'report:run all checks and print a report (default)'
        'snapshot:record a pre-upgrade baseline'
        'list-checks:list available checks'
        'configtest:validate the config file and exit'
        'example-config:print an example config file with all defaults'
        'completion:print a shell completion script'
    )
    if (( CURRENT == 2 )) && [[ $PREFIX != -* ]]; then
        _describe -t commands 'pydebuprep command' commands
        return
    fi
    local cmd=report
    if (( ${commands[(I)${words[2]}:*]} )); then
        cmd=${words[2]}
        shift words
        (( CURRENT-- ))
    fi
    _pydebuprep_${cmd//-/_}
}

_pydebuprep "$@"
