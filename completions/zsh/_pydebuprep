_pydebuprep() {
    local -a commands
    commands=(
        'report:run all checks and print a report (default)'
        'convert:render a saved JSON or YAML report in another format'
        'snapshot:record a pre-upgrade baseline'
        'list-checks:list available checks'
        'configtest:validate the config file and exit'
        'upload:send saved JSON or YAML reports to the portal (default\: those kept after a failed upload)'
        'example-config:print an example config file with all defaults'
        'completion:print a shell completion script'
    )
    if (( CURRENT == 2 )) && [[ $PREFIX != -* ]]; then
        _describe -t commands 'pydebuprep command' commands
        return
    fi
    if (( CURRENT == 2 )); then
        _pydebuprep_first
        return
    fi
    local cmd=report
    if (( ${commands[(I)${words[2]}:*]} )); then
        cmd=${words[2]}
        shift words
        (( CURRENT-- ))
    fi
    _pydebuprep_${cmd//-/_}
}

# Autoloaded from fpath (packaged install) or sourced: source <(pydebuprep completion zsh)
if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
    _pydebuprep "$@"
else
    compdef _pydebuprep pydebuprep
fi
