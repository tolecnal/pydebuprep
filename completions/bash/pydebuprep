# bash completion for pydebuprep -- generated by `pydebuprep completion bash`; do not edit by hand
# shellcheck shell=bash
#
# Installed packages load this automatically through bash-completion. Elsewhere:
#   source <(pydebuprep completion bash)

_pydebuprep_files() {
    # Use bash-completion's _filedir when available, plain compgen otherwise.
    if declare -F _filedir >/dev/null; then
        _filedir "$@"
    else
        # Let readline quote spaces and mark directories, as _filedir would.
        compopt -o filenames 2>/dev/null
        if [[ $1 == -d ]]; then
            mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        else
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
        fi
    fi
}

_pydebuprep_check_option() {
    if [[ $cur == *=* ]]; then
        # readline replaces only the text after '=', so reply with values alone.
        local values=""
        case ${cur%%=*} in
        disk-space.include_remote) values="true false" ;;
        docker.probe) values="true false" ;;
        mariadb.probe) values="true false" ;;
        postgresql.probe) values="true false" ;;
        systemd-critical-services.builtin) values="true false" ;;
        esac
        mapfile -t COMPREPLY < <(compgen -W "$values" -- "${cur#*=}")
        return
    fi
    mapfile -t COMPREPLY < <(compgen -W "apt-lists-age.max_age_days= boot-space.critical_pct= boot-space.warning_pct= config-conflicts.critical_paths= config-conflicts.ignore_paths= debsums.timeout_seconds= disk-space.critical_pct= disk-space.exclude_mounts= disk-space.important_mounts= disk-space.include_remote= disk-space.min_free_mib= disk-space.warning_pct= dmesg-errors.ignore= docker.http_probes= docker.ignore_containers= docker.probe= journal-errors.ignore= mariadb.credentials_file= mariadb.probe= network.ignore_interfaces= postgresql.credentials_file= postgresql.probe= python-venvs.exclude_paths= python-venvs.max_depth= python-venvs.search_paths= systemd-critical-services.builtin= systemd-critical-services.ignore_units= systemd-critical-services.required_active= systemd-critical-services.required_enabled= systemd-failed.ignore_units= systemd-timers.ignore_units=" -- "$cur")
    compopt -o nospace 2>/dev/null
}

_pydebuprep_list() {
    # Complete one item of a comma-separated list, leaving out items already given.
    local prefix="" word="$cur" item remaining=""
    if [[ $cur == *,* ]]; then
        prefix="${cur%,*},"
        word="${cur##*,}"
    fi
    for item in $1; do
        [[ ",$prefix" == *",$item,"* ]] || remaining="$remaining $item"
    done
    mapfile -t COMPREPLY < <(compgen -P "$prefix" -W "$remaining" -- "$word")
    compopt -o nospace 2>/dev/null
}

_pydebuprep() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null; then
        _init_completion -n =: || return
    else
        cur=${COMP_WORDS[COMP_CWORD]}
        prev=${COMP_WORDS[COMP_CWORD - 1]}
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    # --flag=value: complete the value; readline replaces only the text after '='.
    if [[ $cur == --*=* ]]; then
        prev=${cur%%=*}
        cur=${cur#*=}
    fi

    # Like the CLI: a command is only recognised as the first word.
    local commands="report convert snapshot list-checks configtest upload example-config completion"
    local cmd=""
    if ((cword > 1)); then
        case " $commands " in
            *" ${words[1]} "*) cmd=${words[1]} ;;
        esac
    fi

    case $prev in
        --format|-f)
            mapfile -t COMPREPLY < <(compgen -W "text json yaml html markdown jira confluence" -- "$cur")
            return
            ;;
        --output-dir|--snapshot-dir)
            _pydebuprep_files -d
            return
            ;;
        --output|-o|--baseline|--config|-c)
            _pydebuprep_files
            return
            ;;
        --checks|--skip)
            _pydebuprep_list "apache apparmor apt-autoremove apt-held apt-lists-age apt-sources apt-upgradable bind boot-space boot-time bootloader config-conflicts cron debsums disk-space dkms dmesg-errors docker dpkg-audit dpkg-rc firewall fstab journal-errors kernel-running libvirt mariadb needrestart network nginx obsolete-packages os-release postfix postgresql python-venvs ssh-server systemd-critical-services systemd-failed systemd-timers time-sync unattended-upgrades"
            return
            ;;
        --min-severity)
            mapfile -t COMPREPLY < <(compgen -W "info warning critical" -- "$cur")
            return
            ;;
        --check-option)
            _pydebuprep_check_option
            return
            ;;
        --ca-file|--token-file)
            :
            return
            ;;
    esac

    local opts words_for_cmd="" file_arg=""
    case ${cmd:-report} in
        report) opts="--allow-http --baseline --ca-file --check-option --checks --config --format --help --min-severity --no-baseline --no-color --no-config --no-todo --output --output-dir --skip --snapshot-dir --todo --token-file -c -f -h -o" ;;
        convert) opts="--format --help --no-color --no-todo --output --output-dir --todo -f -h -o" ;;
        snapshot) opts="--allow-http --ca-file --check-option --config --help --no-config --snapshot-dir --token-file -c -h" ;;
        list-checks) opts="--help --verbose -h -v" ;;
        configtest) opts="--allow-http --ca-file --config --help --no-config --token-file -c -h" ;;
        upload) opts="--allow-http --ca-file --config --help --no-config --token-file -c -h" ;;
        example-config) opts="--help -h" ;;
        completion) opts="--help -h" ;;
    esac
    case $cmd in
        completion) words_for_cmd="bash zsh" ;;
        convert) file_arg=1 ;;
        upload) file_arg=1 ;;
    esac

    if [[ $cur == -* ]]; then
        ((cword == 1)) && opts="$opts --help --version -h"
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
    elif ((cword == 1)); then
        mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$cur")
    elif [[ -n $words_for_cmd ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$words_for_cmd" -- "$cur")
    elif [[ -n $file_arg ]]; then
        _pydebuprep_files
    fi
}

complete -F _pydebuprep pydebuprep
