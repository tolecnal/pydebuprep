# bash completion for pydebuprep -- generated by `pydebuprep completion bash`; do not edit by hand

_pydebuprep_list() {
    # Complete one item of a comma-separated list.
    local prefix="" word="$cur"
    if [[ $cur == *,* ]]; then
        prefix="${cur%,*},"
        word="${cur##*,}"
    fi
    COMPREPLY=($(compgen -P "$prefix" -W "$1" -- "$word"))
    compopt -o nospace 2>/dev/null
}

_pydebuprep() {
    local cur prev words cword
    _init_completion -n =: || return

    local commands="report snapshot list-checks configtest example-config completion"
    local cmd="" i
    for ((i = 1; i < cword; i++)); do
        case " $commands " in
            *" ${words[i]} "*) cmd=${words[i]}; break ;;
        esac
    done

    case $prev in
        --format|-f)
            COMPREPLY=($(compgen -W "text json yaml html markdown jira confluence" -- "$cur"))
            return
            ;;
        --output-dir|--snapshot-dir)
            _filedir -d
            return
            ;;
        --output|-o|--baseline|--config|-c)
            _filedir
            return
            ;;
        --checks|--skip)
            _pydebuprep_list "apt-autoremove apt-held apt-lists-age apt-sources apt-upgradable boot-space boot-time bootloader config-conflicts debsums disk-space dkms dmesg-errors dpkg-audit dpkg-rc fstab journal-errors kernel-running needrestart obsolete-packages os-release systemd-failed systemd-timers"
            return
            ;;
        --min-severity)
            COMPREPLY=($(compgen -W "info warning critical" -- "$cur"))
            return
            ;;
        --check-option)
            COMPREPLY=($(compgen -W "apt-lists-age.max_age_days= boot-space.critical_pct= boot-space.warning_pct= config-conflicts.critical_paths= debsums.timeout_seconds= disk-space.critical_pct= disk-space.exclude_mounts= disk-space.include_remote= disk-space.warning_pct= dmesg-errors.ignore= journal-errors.ignore= systemd-failed.ignore_units= systemd-timers.ignore_units=" -- "$cur")); compopt -o nospace 2>/dev/null
            return
            ;;
    esac

    local opts words_for_cmd=""
    case ${cmd:-report} in
        report) opts="--baseline --check-option --checks --config --format --help --min-severity --no-baseline --no-color --no-config --output --output-dir --skip --snapshot-dir -c -f -h -o" ;;
        snapshot) opts="--check-option --config --help --no-config --snapshot-dir -c -h" ;;
        list-checks) opts="--help --verbose -h -v" ;;
        configtest) opts="--config --help --no-config -c -h" ;;
        example-config) opts="--help -h" ;;
        completion) opts="--help -h" ;;
    esac
    case $cmd in
        completion) words_for_cmd="bash zsh" ;;
    esac

    if [[ $cur == -* ]]; then
        [[ -z $cmd ]] && opts="$opts --help --version -h"
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    elif [[ -z $cmd ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
    elif [[ -n $words_for_cmd ]]; then
        COMPREPLY=($(compgen -W "$words_for_cmd" -- "$cur"))
    fi
}

complete -F _pydebuprep pydebuprep
