# bash completion for pydebuprep -- generated by `pydebuprep completion bash`; do not edit by hand
#
# Installed packages load this automatically through bash-completion. Elsewhere:
#   source <(pydebuprep completion bash)

_pydebuprep_files() {
    # Use bash-completion's _filedir when available, plain compgen otherwise.
    if declare -F _filedir >/dev/null; then
        _filedir "$@"
    elif [[ $1 == -d ]]; then
        COMPREPLY=($(compgen -d -- "$cur"))
    else
        COMPREPLY=($(compgen -f -- "$cur"))
    fi
}

_pydebuprep_check_option() {
    if [[ $cur == *=* ]]; then
        # readline replaces only the text after '=', so reply with values alone.
        local values=""
        case ${cur%%=*} in
        disk-space.include_remote) values="true false" ;;
        esac
        COMPREPLY=($(compgen -W "$values" -- "${cur#*=}"))
        return
    fi
    COMPREPLY=($(compgen -W "apt-lists-age.max_age_days= boot-space.critical_pct= boot-space.warning_pct= config-conflicts.critical_paths= debsums.timeout_seconds= disk-space.critical_pct= disk-space.exclude_mounts= disk-space.include_remote= disk-space.warning_pct= dmesg-errors.ignore= journal-errors.ignore= systemd-failed.ignore_units= systemd-timers.ignore_units=" -- "$cur"))
    compopt -o nospace 2>/dev/null
}

_pydebuprep_list() {
    # Complete one item of a comma-separated list, leaving out items already given.
    local prefix="" word="$cur" item remaining=""
    if [[ $cur == *,* ]]; then
        prefix="${cur%,*},"
        word="${cur##*,}"
    fi
    for item in $1; do
        [[ ",$prefix" == *",$item,"* ]] || remaining="$remaining $item"
    done
    COMPREPLY=($(compgen -P "$prefix" -W "$remaining" -- "$word"))
    compopt -o nospace 2>/dev/null
}

_pydebuprep() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null; then
        _init_completion -n =: || return
    else
        cur=${COMP_WORDS[COMP_CWORD]}
        prev=${COMP_WORDS[COMP_CWORD - 1]}
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    # --flag=value: complete the value; readline replaces only the text after '='.
    if [[ $cur == --*=* ]]; then
        prev=${cur%%=*}
        cur=${cur#*=}
    fi

    # Like the CLI: a command is only recognised as the first word.
    local commands="report snapshot list-checks configtest example-config completion"
    local cmd=""
    if ((cword > 1)); then
        case " $commands " in
            *" ${words[1]} "*) cmd=${words[1]} ;;
        esac
    fi

    case $prev in
        --format|-f)
            COMPREPLY=($(compgen -W "text json yaml html markdown jira confluence" -- "$cur"))
            return
            ;;
        --output-dir|--snapshot-dir)
            _pydebuprep_files -d
            return
            ;;
        --output|-o|--baseline|--config|-c)
            _pydebuprep_files
            return
            ;;
        --checks|--skip)
            _pydebuprep_list "apt-autoremove apt-held apt-lists-age apt-sources apt-upgradable boot-space boot-time bootloader config-conflicts debsums disk-space dkms dmesg-errors dpkg-audit dpkg-rc fstab journal-errors kernel-running needrestart obsolete-packages os-release systemd-failed systemd-timers"
            return
            ;;
        --min-severity)
            COMPREPLY=($(compgen -W "info warning critical" -- "$cur"))
            return
            ;;
        --check-option)
            _pydebuprep_check_option
            return
            ;;
    esac

    local opts words_for_cmd=""
    case ${cmd:-report} in
        report) opts="--baseline --check-option --checks --config --format --help --min-severity --no-baseline --no-color --no-config --output --output-dir --skip --snapshot-dir -c -f -h -o" ;;
        snapshot) opts="--check-option --config --help --no-config --snapshot-dir -c -h" ;;
        list-checks) opts="--help --verbose -h -v" ;;
        configtest) opts="--config --help --no-config -c -h" ;;
        example-config) opts="--help -h" ;;
        completion) opts="--help -h" ;;
    esac
    case $cmd in
        completion) words_for_cmd="bash zsh" ;;
    esac

    if [[ $cur == -* ]]; then
        ((cword == 1)) && opts="$opts --help --version -h"
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    elif ((cword == 1)); then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
    elif [[ -n $words_for_cmd ]]; then
        COMPREPLY=($(compgen -W "$words_for_cmd" -- "$cur"))
    fi
}

complete -F _pydebuprep pydebuprep
